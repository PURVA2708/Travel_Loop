generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ActivityCategory {
  SIGHTSEEING
  FOOD
  ADVENTURE
  CULTURE
  NIGHTLIFE
}

enum TripStatus {
  DRAFT
  PLANNED
  COMPLETED
}

enum ExpenseCategory {
  TRANSPORT
  STAY
  ACTIVITIES
  MEALS
  MISC
}

enum CollaboratorPermission {
  VIEW
  EDIT
}

// ----------------------------------------------------
// PERSON A DOMAIN: Users, Cities, Activities, Saved
// ----------------------------------------------------

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  passwordHash     String             @map("password_hash")
  avatarUrl        String?            @map("avatar_url")
  languagePref     String             @default("en") @map("language_pref")
  role             Role               @default(USER)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  savedDestinations SavedDestination[]
  trips            Trip[]
  collaborations   TripCollaborator[]

  @@map("users")
}

model City {
  id              String             @id @default(uuid())
  name            String
  country         String
  region          String
  description     String?
  costIndex       Decimal            @default(1.00) @map("cost_index") @db.Decimal(10, 2)
  popularityScore Int                @default(0) @map("popularity_score")
  imageUrl        String?            @map("image_url")
  lat             Decimal?           @db.Decimal(10, 6)
  lng             Decimal?           @db.Decimal(10, 6)
  createdAt       DateTime           @default(now()) @map("created_at")

  activities      Activity[]
  savedByUsers    SavedDestination[]
  tripStops       TripStop[]

  @@index([name])
  @@index([region])
  @@index([country])
  @@map("cities")
}

model Activity {
  id              String           @id @default(uuid())
  cityId          String           @map("city_id")
  name            String
  description     String?
  category        ActivityCategory @default(SIGHTSEEING)
  cost            Decimal          @default(0.00) @db.Decimal(10, 2)
  durationMinutes Int              @default(60) @map("duration_minutes")
  imageUrl        String?          @map("image_url")
  rating          Decimal          @default(4.50) @db.Decimal(3, 2)
  createdAt       DateTime         @default(now()) @map("created_at")

  city            City             @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tripActivities  TripActivity[]

  @@index([cityId])
  @@index([category])
  @@map("activities")
}

model SavedDestination {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  cityId    String   @map("city_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([userId, cityId])
  @@map("saved_destinations")
}

// ----------------------------------------------------
// TEAMMATE DOMAINS: Trips, Budget, Sharing (References)
// ----------------------------------------------------

model Trip {
  id            String             @id @default(uuid())
  userId        String             @map("user_id")
  name          String
  description   String?
  startDate     DateTime?          @map("start_date")
  endDate       DateTime?          @map("end_date")
  coverPhotoUrl String?            @map("cover_photo_url")
  totalBudget   Decimal            @default(0.00) @map("total_budget") @db.Decimal(10, 2)
  status        TripStatus         @default(DRAFT)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops         TripStop[]
  expenses      TripExpense[]
  shareLink     ShareLink?
  collaborators TripCollaborator[]

  @@index([userId])
  @@map("trips")
}

model TripStop {
  id            String         @id @default(uuid())
  tripId        String         @map("trip_id")
  cityId        String         @map("city_id")
  arrivalDate   DateTime?      @map("arrival_date")
  departureDate DateTime?      @map("departure_date")
  orderIndex    Int            @default(0) @map("order_index")

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city          City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  activities    TripActivity[]

  @@index([tripId])
  @@map("trip_stops")
}

model TripActivity {
  id            String    @id @default(uuid())
  tripStopId    String    @map("trip_stop_id")
  activityId    String    @map("activity_id")
  scheduledDate DateTime? @map("scheduled_date")
  scheduledTime String?   @map("scheduled_time")
  actualCost    Decimal?  @map("actual_cost") @db.Decimal(10, 2)
  orderIndex    Int       @default(0) @map("order_index")

  tripStop      TripStop  @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activity      Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([tripStopId])
  @@map("trip_activities")
}

model TripExpense {
  id        String          @id @default(uuid())
  tripId    String          @map("trip_id")
  category  ExpenseCategory @default(MISC)
  amount    Decimal         @db.Decimal(10, 2)
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")

  trip      Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_expenses")
}

model ShareLink {
  id         String   @id @default(uuid())
  tripId     String   @unique @map("trip_id")
  publicSlug String   @unique @map("public_slug")
  allowCopy  Boolean  @default(true) @map("allow_copy")
  createdAt  DateTime @default(now()) @map("created_at")

  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("share_links")
}

model TripCollaborator {
  id         String                 @id @default(uuid())
  tripId     String                 @map("trip_id")
  userId     String                 @map("user_id")
  permission CollaboratorPermission @default(VIEW)

  trip       Trip                   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@map("trip_collaborators")
}
